---
import type { Category, Publisher } from '../types/game';

interface Props {
    categories: Category[];
    publishers: Publisher[];
}

const { categories, publishers } = Astro.props;
---

<form
    class="mb-8 bg-slate-800/60 rounded-xl border border-slate-700/50 p-6 space-y-6"
    data-testid="game-filters"
    aria-label="Filter games"
>
    <fieldset>
        <legend class="text-sm font-semibold text-slate-100 mb-3">Categories</legend>
        <div class="flex flex-wrap gap-3">
            {categories.map((category) => (
                <label class="inline-flex items-center gap-2 rounded-lg bg-slate-700/50 px-3 py-2 text-sm text-slate-200 cursor-pointer hover:bg-slate-700 has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-blue-500">
                    <input
                        type="checkbox"
                        name="category"
                        value={category.id}
                        class="h-4 w-4 rounded border-slate-500 bg-slate-800 accent-blue-500 focus:outline-none"
                        data-testid={`filter-category-${category.id}`}
                    />
                    <span>{category.name}</span>
                </label>
            ))}
        </div>
    </fieldset>

    <div class="flex flex-wrap items-end gap-4">
        <div>
            <label for="publisher-filter" class="block text-sm font-semibold text-slate-100 mb-2">Publisher</label>
            <select
                id="publisher-filter"
                name="publisher"
                class="rounded-lg bg-slate-700 border border-slate-600 px-3 py-2 text-sm text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                data-testid="filter-publisher"
            >
                <option value="">All publishers</option>
                {publishers.map((publisher) => (
                    <option value={publisher.id}>{publisher.name}</option>
                ))}
            </select>
        </div>
        <button
            type="button"
            class="rounded-lg bg-slate-700 px-4 py-2 text-sm font-medium text-slate-100 transition-colors hover:bg-slate-600 focus:ring-2 focus:ring-blue-500 focus:outline-none"
            data-testid="filter-clear"
        >
            Clear filters
        </button>
    </div>

    <p class="text-sm text-slate-300" role="status" aria-live="polite" data-testid="filter-result-count"></p>
</form>
