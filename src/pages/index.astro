---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import GameFilters from '../components/GameFilters.astro';
import { getAllGames, getAllCategories, getAllPublishers } from '../lib/games';

export const prerender = true;

const db = getDatabase();
const games = await getAllGames(db);
const categories = await getAllCategories(db);
const publishers = await getAllPublishers(db);
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <GameFilters categories={categories} publishers={publishers} />
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
            {games.map((game) => <GameCard game={game} />)}
          </div>
          <div class="hidden" data-testid="no-matching-games">
            <EmptyState text="No games match the selected filters." />
          </div>
        </>
      )}
    </div>
  </div>
</Layout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-testid="game-filters"]');
  if (form) {
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));
    const grid = document.querySelector<HTMLElement>('[data-testid="games-grid"]');
    const emptyMessage = document.querySelector<HTMLElement>('[data-testid="no-matching-games"]');
    const count = form.querySelector<HTMLElement>('[data-testid="filter-result-count"]');
    const checkboxes = Array.from(form.querySelectorAll<HTMLInputElement>('input[name="category"]'));
    const publisher = form.querySelector<HTMLSelectElement>('select[name="publisher"]');
    const clear = form.querySelector<HTMLButtonElement>('[data-testid="filter-clear"]');

    const apply = (): void => {
      const categoryIds = checkboxes.filter((c) => c.checked).map((c) => c.value);
      const publisherId = publisher?.value ?? '';
      let visible = 0;
      for (const card of cards) {
        const matches =
          (categoryIds.length === 0 || categoryIds.includes(card.dataset.categoryId ?? '')) &&
          (publisherId === '' || card.dataset.publisherId === publisherId);
        card.style.display = matches ? '' : 'none';
        if (matches) visible++;
      }
      if (grid) grid.style.display = visible === 0 ? 'none' : '';
      emptyMessage?.classList.toggle('hidden', visible !== 0);
      if (count) count.textContent = `Showing ${visible} of ${cards.length} games`;

      const params = new URLSearchParams();
      for (const id of categoryIds) params.append('category', id);
      if (publisherId) params.set('publisher', publisherId);
      const query = params.toString();
      history.replaceState(null, '', query ? `?${query}` : location.pathname);
    };

    const initial = new URLSearchParams(location.search);
    const initialCategories = initial.getAll('category');
    for (const checkbox of checkboxes) checkbox.checked = initialCategories.includes(checkbox.value);
    if (publisher) publisher.value = initial.get('publisher') ?? '';
    if (publisher && publisher.value !== (initial.get('publisher') ?? '')) publisher.value = '';

    form.addEventListener('submit', (event) => event.preventDefault());
    form.addEventListener('change', apply);
    clear?.addEventListener('click', () => {
      for (const checkbox of checkboxes) checkbox.checked = false;
      if (publisher) publisher.value = '';
      apply();
    });
    apply();
  }
</script>
